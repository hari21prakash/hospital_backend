# .NET does NOT read .env files automatically.
# This file documents the configuration keys the backend expects.
# Set them with `dotnet user-secrets` (development) or real environment variables (production).
#
# Environment variable form (double underscore = nested key):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hms_db;Username=postgres;Password=hari2109
Cors__AllowedOrigins__0=http://localhost:5173

Jwt__Key=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=HospitalManagement.Api
Jwt__Audience=HospitalManagement.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Demo data (sample department/doctor/patient/lab tests/ward/beds). Keep false in production.
# SeedDemoData=false

# Optional first-run Super Admin provisioning. Keep credentials in user-secrets locally.
# BootstrapAdmin__Email=
# BootstrapAdmin__Password=
